# Copy to .env. .env is git-ignored.
# LangSmith tracing uploads questions, slide excerpts, prompts and answers to LangChain.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_replace_me
LANGSMITH_PROJECT=maia-gpt

# Optional: keep structure only, strip prompts and answers from uploads.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
